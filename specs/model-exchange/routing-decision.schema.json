{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoutingDecision",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "winner",
    "why_this_model"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "winner": {
      "type": "object",
      "required": [
        "model_id",
        "provider",
        "revision"
      ],
      "properties": {
        "model_id": { "type": "string" },
        "provider": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "provider",
          "revision"
        ],
        "properties": {
          "model_id": { "type": "string" },
          "provider": { "type": "string" },
          "revision": { "type": "string" }
        }
      }
    },
    "why_this_model": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
