{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoutingRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "task_class",
    "mode",
    "requirements"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "task_class": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "MAX_QUALITY",
        "BEST_VALUE",
        "FAST",
        "BULK",
        "EXPERIMENT",
        "REDUNDANT",
        "CRITICAL"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "description": "TASK-007 supports exact provider and revision requirements. Runtime rejects unknown requirement semantics fail-closed.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "x-yastroyka-unknown-requirements": "fail-closed"
    }
  }
}
