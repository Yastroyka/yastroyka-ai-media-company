{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductContentPack",
  "type": "object",
  "required": [
    "product",
    "offer",
    "offer_snapshot",
    "rights",
    "tracking"
  ],
  "properties": {
    "product": {
      "$ref": "catalog-product.schema.json"
    },
    "offer": {
      "$ref": "seller-offer.schema.json"
    },
    "offer_snapshot": {
      "$ref": "offer-snapshot.schema.json"
    },
    "rights": {
      "type": "object",
      "required": [
        "source",
        "verified_at",
        "allowed_channels"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "allowed_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source",
          "verified_at"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "tracking": {
      "type": "object",
      "required": [
        "source_mode",
        "product_id",
        "offer_id",
        "snapshot_captured_at",
        "built_at"
      ],
      "properties": {
        "source_mode": {
          "enum": [
            "real",
            "staging"
          ]
        },
        "product_id": {
          "type": "string"
        },
        "offer_id": {
          "type": "string"
        },
        "snapshot_captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "built_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
