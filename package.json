{
  "name": "@yastroyka/ai-media-company",
  "version": "0.1.0",
  "private": true,
  "description": "YASTROYKA AI MEDIA COMPANY — owned AI media operating system and content factory.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "scripts": {
    "toolchain:check": "node scripts/doctor.mjs",
    "codex:smoke": "node scripts/codex-smoke.mjs",
    "test:codex-hooks": "node --test .codex/hooks/policy.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "quality:check": "pnpm run toolchain:check && pnpm run codex:smoke && pnpm run test:codex-hooks && pnpm run lint && pnpm run format:check"
  }
}
